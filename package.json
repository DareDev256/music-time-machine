{
  "name": "music-time-machine",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=moderate",
    "cf:build": "node scripts/era-manifest.mjs && CF_BUILD=1 NEXT_PUBLIC_SITE_URL=https://music-time-machine.mini-outage-watch.workers.dev opennextjs-cloudflare build",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@vercel/og": "^0.6.0",
    "convex": "1.46.0",
    "lucide-react": "^0.575.0",
    "next": "^16.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.170.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^25.0.0",
    "playwright": "1.58.2",
    "tailwindcss": "^4",
    "typescript": "5.9.3",
    "vitest": "^3.0.0",
    "wrangler": "^4.165.0"
  }
}
