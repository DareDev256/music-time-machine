# Music Time Machine — Environment Variables
# Copy this file to .env.local and fill in your keys.
# All variables are optional — the app works with zero config using mock data.

# Spotify API (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data API v3 (https://console.cloud.google.com)
YOUTUBE_API_KEY=

# Genius API (https://genius.com/api-clients)
GENIUS_ACCESS_TOKEN=

# Set to "false" to use real APIs with mock fallback (default: "true")
USE_MOCK_DATA=true
