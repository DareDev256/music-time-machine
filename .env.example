# Music Time Machine - Environment Variables
# Copy this file to .env.local and fill in your API keys

# =============================================================================
# Spotify API
# Get credentials at: https://developer.spotify.com/dashboard
# 1. Create an app in the Spotify Developer Dashboard
# 2. Copy the Client ID and Client Secret
# =============================================================================
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# =============================================================================
# YouTube Data API v3
# Get credentials at: https://console.cloud.google.com/apis/credentials
# 1. Create a project in Google Cloud Console
# 2. Enable the YouTube Data API v3
# 3. Create an API Key
# =============================================================================
YOUTUBE_API_KEY=your_youtube_api_key

# =============================================================================
# Genius API
# Get credentials at: https://genius.com/api-clients
# 1. Create an API Client
# 2. Generate an Access Token
# =============================================================================
GENIUS_ACCESS_TOKEN=your_genius_access_token

# =============================================================================
# Billboard - No API key needed (uses web scraping/mock data)
# =============================================================================

# =============================================================================
# Mock Data Mode
# Set to 'true' to use mock data even when API keys are present
# Set to 'false' to use real APIs (requires valid API keys above)
# =============================================================================
USE_MOCK_DATA=true
